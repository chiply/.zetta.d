#!/usr/bin/env bash
# zetta — CLI wrapper for Zetta Emacs
#
# Usage: zetta <command> [args]
#
# Commands:
#   install   Install packages and native-compile
#   sync      Re-evaluate config, install new packages
#   freeze    Write lockfile and optionally commit
#   update    Pull all packages (backs up lockfile first)
#   doctor    Diagnose environment and configuration
#   test      Start a test daemon and verify startup
#   ci-sync   Install missing packages after stale cache restore
#   ci-test   Batch-mode test for CI runners (no daemon)
#   help      Show this help message

set -euo pipefail

# Resolve the directory this script lives in
ZETTA_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LOCK_FILE="$ZETTA_DIR/elpaca-lock.el"
EMACS="${EMACS:-emacs}"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

_info()  { echo -e "${CYAN}::${NC} $*"; }
_ok()    { echo -e "${GREEN}✓${NC} $*"; }
_warn()  { echo -e "${YELLOW}!${NC} $*"; }
_error() { echo -e "${RED}✗${NC} $*"; }
_sha256() {
    if command -v sha256sum &>/dev/null; then sha256sum "$1" | cut -d' ' -f1
    else shasum -a 256 "$1" | cut -d' ' -f1; fi
}

# ——————————————————————————————————————————
# prebuilt store
# ——————————————————————————————————————————

# CI publishes prebuilt elpaca stores (builds + treeless sources) to a
# rolling GitHub release on every merge to main; seeding from one lets
# a fresh install skip the package-build phase entirely (~1h on modest
# hardware -> minutes).  Safety model: the artifact is addressed by
# Emacs major.minor, but its manifest carries the sha256 of the
# elpaca-lock.el it was built from and the EXACT emacs-version that
# byte-compiled it, and both must match.  .elc is portable across
# OSes but only across Emacsen built from identical Lisp sources --
# which the version string pins for releases and does NOT pin for
# pretests: a 31.0.50 master snapshot and a 31.0.90 release-branch
# build share artifact key "31.0" yet differ in core macros/setters
# (measured 2026-07-25: a 31.0.90-compiled store called the named
# setter (setf image-property), void-function on 31.0.50).  ANY
# mismatch -- version, lock, download, extraction -- falls back to
# the normal source build, so a stale or missing artifact can only
# make an install slower, never wrong.
# Native-compiled .eln is never shipped: Emacs regenerates it locally
# in the background.  Opt out with ZETTA_NO_PREBUILT=1; point
# ZETTA_PREBUILT_URL at an alternate base URL (or file:// path) for
# testing.
PREBUILT_BASE="${ZETTA_PREBUILT_URL:-https://github.com/chiply/.zetta.d/releases/download/prebuilt}"

try_prebuilt() {
    [[ "${ZETTA_NO_PREBUILT:-}" == "1" ]] && return 1
    # Fresh installs only: an existing store belongs to elpaca.
    [[ -d "$ZETTA_DIR/elpaca/builds" ]] && return 1
    local mm
    mm=$("$EMACS" -Q --batch --eval '(princ (format "%s.%s" emacs-major-version emacs-minor-version))' 2>/dev/null) || return 1
    local url="$PREBUILT_BASE/zetta-elpaca-${mm}.tar.zst"
    local tmpdir
    tmpdir=$(mktemp -d) || return 1
    _info "Trying prebuilt store for Emacs ${mm}..."
    if ! curl -fL --retry 2 --progress-bar -o "$tmpdir/store.tar.zst" "$url"; then
        _info "No prebuilt store for Emacs $mm (building from source)"
        rm -rf "$tmpdir"; return 1
    fi
    if ! tar -xf "$tmpdir/store.tar.zst" -C "$tmpdir"; then
        _warn "Prebuilt store: extraction failed (tar with zstd support required); building from source"
        rm -rf "$tmpdir"; return 1
    fi
    local lock_sha manifest_sha
    lock_sha=$(_sha256 "$LOCK_FILE")
    manifest_sha=$(grep -o '"lock_sha256": *"[a-f0-9]\{64\}"' "$tmpdir/elpaca-manifest.json" 2>/dev/null | grep -o '[a-f0-9]\{64\}')
    if [[ -z "$manifest_sha" || "$manifest_sha" != "$lock_sha" ]]; then
        _warn "Prebuilt store does not match elpaca-lock.el (stale artifact); building from source"
        rm -rf "$tmpdir"; return 1
    fi
    local full manifest_emacs
    full=$("$EMACS" -Q --batch --eval '(princ emacs-version)' 2>/dev/null) || return 1
    manifest_emacs=$(grep -o '"emacs": *"[^"]*"' "$tmpdir/elpaca-manifest.json" 2>/dev/null \
        | head -1 | sed 's/.*"\([^"]*\)"$/\1/')
    if [[ -z "$manifest_emacs" || "$manifest_emacs" != "$full" ]]; then
        _warn "Prebuilt store was byte-compiled by Emacs ${manifest_emacs:-unknown}; local Emacs is ${full}. Building from source"
        rm -rf "$tmpdir"; return 1
    fi
    mv "$tmpdir/elpaca" "$ZETTA_DIR/elpaca"
    # Keep the manifest inside the store so the startup check
    # (bootstrap-store-check.el) can flag a later Emacs switch.
    mv "$tmpdir/elpaca-manifest.json" "$ZETTA_DIR/elpaca/elpaca-manifest.json"
    rm -rf "$tmpdir"
    _ok "Prebuilt store installed (package builds will be skipped)"
}

# ——————————————————————————————————————————
# install
# ——————————————————————————————————————————
cmd_install() {
    _info "Installing Zetta Emacs packages..."

    # Create required files
    touch ~/.dir-locals.el
    if [[ ! -f ~/.private.el ]]; then
        _warn "Creating empty ~/.private.el (add your API keys here)"
        echo ";; Private configuration — API keys, credentials, etc." > ~/.private.el
        echo ";; See $ZETTA_DIR/.private.sample.el for required variables." >> ~/.private.el
    fi

    if [[ ! -f ~/.zetta.el ]]; then
        _info "Copying default user config to ~/.zetta.el"
        cp "$ZETTA_DIR/templates/zetta.example.el" ~/.zetta.el
    fi

    # Purge stale compiled artifacts BEFORE the install Emacs starts.  The
    # phase-1 Emacs loads the bootstrap from whatever compiled form exists,
    # and Emacs transparently prefers a matching eln-cache entry over the
    # .elc/.el on disk — so a .eln native-compiled from since-corrected
    # bytecode silently shadows the fix (measured 2026-07-23: a stale
    # bootstrap-compile-angel.eln from the broken-bootstrap window crashed
    # phase 1 with void-variable even though the on-disk .elc was correct).
    # CI never sees this class of failure: fresh checkouts have no
    # eln-cache and no .elc files.  Both are pure caches — the byte-compile
    # and native-compile steps below regenerate them.  The same applies
    # when rolling back to an elpaca.pre-*.bak snapshot: purge eln-cache.
    _info "Purging stale compiled artifacts (eln-cache, module/bootstrap .elc)..."
    rm -rf "$ZETTA_DIR/eln-cache"
    find "$ZETTA_DIR/modules" "$ZETTA_DIR/source" -name '*.elc' -delete 2>/dev/null || true

    # Seed from a prebuilt store when possible (fresh installs only;
    # every mismatch falls back to the source build below).
    try_prebuilt || true

    # A source build compiles against the local Emacs, so a manifest
    # left over from an earlier store seed would misreport the
    # bytecode's builder to the startup check (bootstrap-store-check).
    # Reaching here with no builds/ means no store was just installed
    # -- drop any stale manifest before building.
    [[ -d "$ZETTA_DIR/elpaca/builds" ]] || rm -f "$ZETTA_DIR/elpaca/elpaca-manifest.json"

    _info "Starting Emacs to install and build packages..."
    "$EMACS" --init-directory="$ZETTA_DIR" --batch \
        -l "$ZETTA_DIR/init.el" \
        --eval "(defvar zetta--install-timer nil)" \
        --eval "(defvar zetta--install-prev-done 0)" \
        --eval "(defvar zetta--install-stall-since nil)" \
        --eval "(let* ((start (float-time))
                       (timeout 600)
                       (stall-limit 600))
                  (setq zetta--install-timer
                        (run-with-timer 10 10
                         (lambda ()
                           (let ((pending 0) (failed 0) (total 0) (done 0) (stuck nil))
                             (dolist (entry (elpaca--queued))
                               (cl-incf total)
                               (pcase (elpaca<-status (cdr entry))
                                 ('failed (cl-incf failed))
                                 ((or 'finished 'blocked) (cl-incf done))
                                 (_ (cl-incf pending)
                                    (push (format \"%s [%s]\" (car entry)
                                                  (elpaca<-status (cdr entry)))
                                          stuck))))
                             (message \"install: %d/%d done, %d pending, %d failed (%.0fs)\"
                                      done total pending failed
                                      (- (float-time) start))
                             (if (> done zetta--install-prev-done)
                                 (progn (setq zetta--install-prev-done done)
                                        (setq zetta--install-stall-since nil))
                               (when (and stuck (not zetta--install-stall-since))
                                 (setq zetta--install-stall-since (float-time)))
                               (when (and zetta--install-stall-since
                                          (> (- (float-time) zetta--install-stall-since) stall-limit))
                                 (message \"install: no progress for %ds, giving up on: %s\"
                                          stall-limit (string-join stuck \", \"))
                                 (cancel-timer zetta--install-timer)
                                 (throw 'elpaca-timeout nil))))
                           (when (> (- (float-time) start) timeout)
                             (message \"INSTALL-TIMEOUT after %ds\" timeout)
                             (cancel-timer zetta--install-timer)
                             (throw 'elpaca-timeout nil)))))
                  (catch 'elpaca-timeout
                    (unwind-protect (elpaca-wait) (cancel-timer zetta--install-timer)))
                  (message \"Package installation finished in %.0fs\" (- (float-time) start)))" \
        2>&1 | while IFS= read -r line; do
            echo "  $line"
        done

    _ok "Package installation complete"

    _info "Byte-compiling modules and bootstrap..."
    find "$ZETTA_DIR/modules" "$ZETTA_DIR/source" -name '*.elc' -delete
    "$EMACS" --init-directory="$ZETTA_DIR" --batch \
        -l "$ZETTA_DIR/init.el" \
        --eval "(elpaca-wait)" \
        --eval "(byte-recompile-directory \"$ZETTA_DIR/modules\" 0)" \
        --eval "(byte-recompile-directory \"$ZETTA_DIR/source/bootstrap\" 0)" \
        2>&1 | while IFS= read -r line; do
            echo "  $line"
        done
    _ok "Module byte-compilation complete"

    _info "Native-compiling packages (this may take a while)..."
    "$EMACS" --init-directory="$ZETTA_DIR" --batch \
        --eval "(require 'comp)" \
        --eval "(native-compile-async \"$ZETTA_DIR/elpaca/builds\" 'recursively)" \
        --eval "(while (or comp-files-queue
                        (> (hash-table-count comp-async-compilations) 0))
                  (sleep-for 1))" \
        2>&1 | while IFS= read -r line; do
            echo "  $line"
        done

    _ok "Zetta Emacs installed successfully"
    echo ""
    _info "Next steps:"
    echo "  1. Edit ~/.zetta.el to customize modules and settings"
    echo "  2. Edit ~/.private.el to add API keys (see .private.sample.el)"
    echo "  3. Start Emacs!"
}

# ——————————————————————————————————————————
# sync
# ——————————————————————————————————————————
cmd_sync() {
    _info "Syncing Zetta Emacs configuration..."

    "$EMACS" --init-directory="$ZETTA_DIR" --batch \
        -l "$ZETTA_DIR/init.el" \
        --eval "(elpaca-wait)" \
        --eval "(message \"Sync complete: %d packages queued\" (length (elpaca--queued)))" \
        2>&1 | while IFS= read -r line; do
            echo "  $line"
        done

    _info "Byte-compiling modules and bootstrap..."
    find "$ZETTA_DIR/modules" "$ZETTA_DIR/source" -name '*.elc' -delete
    "$EMACS" --init-directory="$ZETTA_DIR" --batch \
        -l "$ZETTA_DIR/init.el" \
        --eval "(elpaca-wait)" \
        --eval "(byte-recompile-directory \"$ZETTA_DIR/modules\" 0)" \
        --eval "(byte-recompile-directory \"$ZETTA_DIR/source/bootstrap\" 0)" \
        2>&1 | while IFS= read -r line; do
            echo "  $line"
        done

    _ok "Sync complete"
}

# ——————————————————————————————————————————
# freeze
# ——————————————————————————————————————————
cmd_freeze() {
    _info "Generating lockfile..."

    "$EMACS" --init-directory="$ZETTA_DIR" --batch \
        -l "$ZETTA_DIR/init.el" \
        --eval "(elpaca-wait)" \
        --eval "(setq elpaca-lock-file-functions (list (lambda (_e) t)))" \
        --eval "(elpaca-write-lock-file \"$LOCK_FILE\")" \
        --eval "(message \"Lock file written to %s\" \"$LOCK_FILE\")" \
        2>&1 | while IFS= read -r line; do
            echo "  $line"
        done

    if [[ -f "$LOCK_FILE" ]]; then
        local count
        count=$(wc -l < "$LOCK_FILE" | tr -d ' ')
        _ok "Lockfile written ($count lines)"

        # Optionally commit
        if [[ "${1:-}" == "--commit" ]]; then
            cd "$ZETTA_DIR"
            git add elpaca-lock.el
            git commit -m "chore: update elpaca lockfile"
            _ok "Committed lockfile"
        else
            _info "Run 'zetta freeze --commit' to also commit the lockfile"
        fi
    else
        _error "Failed to generate lockfile"
        return 1
    fi
}

# ——————————————————————————————————————————
# update
# ——————————————————————————————————————————
cmd_update() {
    # Backup lockfile
    if [[ -f "$LOCK_FILE" ]]; then
        cp "$LOCK_FILE" "${LOCK_FILE}.bak"
        _info "Backed up lockfile to elpaca-lock.el.bak"
    fi

    _info "Pulling all packages..."

    "$EMACS" --init-directory="$ZETTA_DIR" --batch \
        -l "$ZETTA_DIR/init.el" \
        --eval "(elpaca-wait)" \
        --eval "(elpaca-pull-all)" \
        --eval "(elpaca-wait)" \
        --eval "(message \"Update complete\")" \
        2>&1 | while IFS= read -r line; do
            echo "  $line"
        done

    _ok "Packages updated"
    _info "Run 'zetta freeze' to update the lockfile with new versions"
}

# ——————————————————————————————————————————
# doctor
# ——————————————————————————————————————————
cmd_doctor() {
    echo -e "${BOLD}Zetta Emacs Doctor${NC}"
    echo ""

    # Emacs version
    local emacs_version
    emacs_version=$("$EMACS" --version 2>/dev/null | head -1)
    if [[ -n "$emacs_version" ]]; then
        _ok "Emacs: $emacs_version"
        # Check version >= 29
        local major
        major=$(echo "$emacs_version" | grep -oE '[0-9]+' | head -1)
        if [[ "$major" -lt 29 ]]; then
            _warn "Zetta requires Emacs 29+. You have Emacs $major."
        fi
    else
        _error "Emacs not found"
    fi

    # Git
    if command -v git &>/dev/null; then
        _ok "Git: $(git --version | head -1)"
    else
        _error "Git not found (required)"
    fi

    # ripgrep
    if command -v rg &>/dev/null; then
        _ok "ripgrep: $(rg --version | head -1)"
    else
        _warn "ripgrep not found (recommended for consult-ripgrep)"
    fi

    # fd
    if command -v fd &>/dev/null; then
        _ok "fd: $(fd --version)"
    else
        _warn "fd not found (recommended for fast file search)"
    fi

    # Node.js (for LSP servers)
    if command -v node &>/dev/null; then
        _ok "Node.js: $(node --version)"
    else
        _warn "Node.js not found (needed for some LSP servers)"
    fi

    # Python
    if command -v python3 &>/dev/null; then
        _ok "Python: $(python3 --version)"
    else
        _warn "Python3 not found"
    fi

    echo ""

    # Zetta directory
    if [[ -d "$ZETTA_DIR" ]]; then
        _ok "Zetta directory: $ZETTA_DIR"
    else
        _error "Zetta directory not found: $ZETTA_DIR"
    fi

    # Lockfile
    if [[ -f "$LOCK_FILE" ]]; then
        local lock_count
        lock_count=$(wc -l < "$LOCK_FILE" | tr -d ' ')
        _ok "Lockfile: $LOCK_FILE ($lock_count lines)"
    else
        _warn "No lockfile found (run 'zetta freeze' to generate)"
    fi

    # User config
    if [[ -f ~/.zetta.el ]]; then
        _ok "User config: ~/.zetta.el"
    else
        _warn "No ~/.zetta.el found (run 'zetta install' or copy from templates/)"
    fi

    # Private config
    if [[ -f ~/.private.el ]]; then
        _ok "Private config: ~/.private.el"
    else
        _warn "No ~/.private.el found (API keys will not be available)"
    fi

    # Elpaca directory
    if [[ -d "$ZETTA_DIR/elpaca/builds" ]]; then
        local pkg_count
        pkg_count=$(ls -d "$ZETTA_DIR/elpaca/builds"/*/ 2>/dev/null | wc -l | tr -d ' ')
        _ok "Installed packages: $pkg_count"

        # Bytecode <-> Emacs consistency.  Every .elc records the Emacs
        # that compiled it on its third header line; bytecode from a
        # different build can reference functions this Emacs lacks
        # (pretest version numbers span months of source drift, see the
        # prebuilt-store comment above).  Census the headers, whatever
        # their origin -- prebuilt store or local builds.
        local full compilers others
        full=$("$EMACS" -Q --batch --eval '(princ emacs-version)' 2>/dev/null)
        compilers=$(find "$ZETTA_DIR/elpaca/builds" -name '*.elc' \
                -exec grep -a -h -m1 -o 'in Emacs version [0-9.]*' {} + 2>/dev/null \
            | sed 's/in Emacs version //' | sort | uniq -c | sort -rn)
        others=$(echo "$compilers" | awk -v v="$full" 'NF && $2 != v')
        if [[ -z "$compilers" ]]; then
            _warn "No .elc files found under elpaca/builds"
        elif [[ -n "$others" ]]; then
            _warn "Bytecode compiled by a different Emacs than $full (count, version):"
            echo "$compilers" | while IFS= read -r line; do
                echo "    $line"
            done
            echo "    Fix: run the matching Emacs, or rebuild: rm -rf $ZETTA_DIR/elpaca && bin/zetta install"
        else
            _ok "Bytecode: all .elc compiled by Emacs $full"
        fi
    else
        _warn "No packages installed (run 'zetta install')"
    fi

    # Modules directory
    if [[ -d "$ZETTA_DIR/modules" ]]; then
        local mod_count=0
        for dir in "$ZETTA_DIR/modules"/*/; do
            if [[ -d "$dir" ]]; then
                ((mod_count++))
            fi
        done
        _ok "Module categories: $mod_count"
    else
        _error "Modules directory not found"
    fi

    echo ""
}

# ——————————————————————————————————————————
# test
# ——————————————————————————————————————————
cmd_test() {
    local daemon_name="zetta-test-$$"

    _info "Starting test daemon ($daemon_name)..."

    local output exit_code=0
    output=$("$EMACS" --init-directory="$ZETTA_DIR" --daemon="$daemon_name" 2>&1) || exit_code=$?

    if [[ $exit_code -ne 0 ]]; then
        _error "Daemon failed to start (exit code: $exit_code)"
        echo "$output"
        return 1
    fi

    # Verify responsiveness via emacsclient
    local response
    response=$(emacsclient -s "$daemon_name" -e '(message "Config OK")' 2>&1)
    if [[ "$response" == '"Config OK"' ]]; then
        _ok "Daemon started and responding"
    else
        _error "Daemon process exited 0 but emacsclient failed: $response"
        echo "$output"
        return 1
    fi

    # Check for errors in *Messages* buffer
    local messages
    messages=$(emacsclient -s "$daemon_name" -e '(with-current-buffer "*Messages*" (buffer-string))' 2>&1)
    local errors
    errors=$(echo "$messages" | grep -iE "void-function|wrong-type-argument|debug-early" \
        | grep -v "use-package" \
        | grep -v "elpaca" \
        || true)

    if [[ -n "$errors" ]]; then
        _warn "Warnings detected:"
        echo "$errors" | while IFS= read -r line; do
            echo "  $line"
        done
    fi

    # Report stats
    local pkg_count
    pkg_count=$(emacsclient -s "$daemon_name" -e '(length (elpaca--queued))' 2>&1)
    _info "Packages queued: $pkg_count"

    local module_count
    module_count=$(emacsclient -s "$daemon_name" -e '(length user-files)' 2>&1)
    _info "Module files loaded: $module_count"

    # Cleanup
    emacsclient -s "$daemon_name" -e '(kill-emacs)' 2>/dev/null
    _ok "Test daemon stopped"
}

# ——————————————————————————————————————————
# ci-sync  (install missing packages on stale cache)
# ——————————————————————————————————————————

# Watchdog installed BEFORE init.el loads.  The sync/test harnesses put
# their stall detectors in --eval forms AFTER -l init.el, but init.el's
# own category-boundary elpaca-wait can hang first (measured: 15 silent
# minutes after tools/tilt.el, run 29879440841) -- and by then no
# detector exists, so the job eats the full job timeout with no package
# named in the log.  Timers fire inside elpaca-wait's sit-for loop, so a
# timer registered up front reports from within that hang: a status line
# every minute, and after a stretch with no order reaching a terminal
# state, a dump of every stuck order with its most recent event text,
# then exit 70 so the step fails fast and named instead of silently
# timing out.
ZETTA_CI_WATCHDOG="(progn
  (defvar zetta--wd-prev \"\")
  (defvar zetta--wd-stall 0)
  ;; elpaca's per-order log slot is gone (2026 struct redesign); the
  ;; global event log ('elpaca--event-log', newest first) is the batch
  ;; introspection surface.  An event's human-readable text is :info
  ;; (elpaca-note -- includes failure reasons) or :output (subprocess
  ;; output); bare status-transition events carry neither, skip them.
  (defun zetta--elpaca-events (id n)
    \"Up to N most recent elpaca event texts for package ID, oldest first.\"
    (let (texts)
      (catch 'done
        (dolist (ev (elpaca-event-log id))
          (let* ((payload (elpaca-event<-payload ev))
                 (text (or (plist-get payload :info)
                           (plist-get payload :output))))
            (when text
              (push text texts)
              (when (>= (length texts) n) (throw 'done nil))))))
      texts))
  (run-with-timer 60 60
   (lambda ()
     (when (featurep 'elpaca)
       (let ((done 0) (total 0) (waiting nil))
         (dolist (entry (elpaca--queued))
           (setq total (1+ total))
           (let ((s (elpaca<-status (cdr entry))))
             ;; 'blocked is NOT terminal here: elpaca-wait keeps waiting
             ;; on blocked orders, so one blocked forever (dep of a failed
             ;; package, monorepo partner) spins the wait while an
             ;; all-terminal watchdog stays silent to the job ceiling
             ;; (measured: run 29946929141/30.2 sat 7+ min at
             ;; \"300/300 terminal\" before the 60-minute cancel).  In the
             ;; waiting set, a frozen blocked order is dumped and killed
             ;; like any other wedge.
             (if (memq s '(finished failed))
                 (setq done (1+ done))
               (push (format \"%s[%s]\" (car entry) s) waiting))))
         (let ((wstr (mapconcat #'identity (sort waiting #'string<) \" \")))
           (message \"watchdog: %d/%d terminal%s\" done total
                    (if waiting (concat \" -- waiting: \" wstr) \"\"))
           ;; A stall is the waiting SET frozen -- same orders in the same
           ;; states -- not merely a quiet minute: 30 parallel clones can
           ;; legitimately produce zero newly-terminal orders for a while
           ;; (measured: the first flat-progress criterion killed a healthy
           ;; run mid-clone of the app category, run 29933654049/30.2).
           (if (and waiting (equal wstr zetta--wd-prev))
               (setq zetta--wd-stall (1+ zetta--wd-stall))
             (setq zetta--wd-stall 0))
           (setq zetta--wd-prev wstr)
           (when (and waiting (>= zetta--wd-stall 10)
                      (= 0 (mod zetta--wd-stall 10)))
             (message \"WATCHDOG-STALL: waiting set frozen for %d minutes:\"
                      zetta--wd-stall)
             (dolist (entry (elpaca--queued))
               (let* ((e (cdr entry)) (s (elpaca<-status e)))
                 ;; Failed orders are terminal but they are USUALLY the
                 ;; reason others sit blocked -- without them the dump
                 ;; names victims and hides the culprit (measured: three
                 ;; elfeed dependents frozen [blocked], the failed elfeed
                 ;; order that caused it invisible).
                 (cond
                  ((eq s 'failed)
                   (dolist (msg (zetta--elpaca-events (car entry) 4))
                     (message \"  FAILED: %s | %s\" (car entry) msg)))
                  ((eq s 'finished) nil)
                  (t
                   (message \"  STUCK: %s [%s] step=%s conditions=%S %s\"
                            (car entry) s (elpaca<-current-step e)
                            (elpaca<-conditions e)
                            (or (car (last (zetta--elpaca-events (car entry) 1))) \"\")))))))
           (when (and waiting (>= zetta--wd-stall 20))
             (kill-emacs 70))))))))"

cmd_ci_sync() {
    _info "Syncing packages (stale cache detected)…"

    # Create required files if missing
    touch ~/.dir-locals.el
    [[ -f ~/.private.el ]] || echo ";;" > ~/.private.el
    [[ -f ~/.zetta.el ]] || cp "$ZETTA_DIR/templates/zetta.example.el" ~/.zetta.el

    local exit_code=0
    "$EMACS" --init-directory="$ZETTA_DIR" --batch \
        --eval "$ZETTA_CI_WATCHDOG" \
        -l "$ZETTA_DIR/init.el" \
        --eval "(defvar zetta--sync-timer nil)" \
        --eval "(defvar zetta--sync-prev-done 0)" \
        --eval "(defvar zetta--sync-stall-since nil)" \
        --eval "(let* ((start (float-time))
                       (timeout 900)
                       (stall-limit 600))
                  (setq zetta--sync-timer
                        (run-with-timer 5 10
                         (lambda ()
                           (let ((pending 0) (failed 0) (total 0) (done 0) (stuck nil))
                             (dolist (entry (elpaca--queued))
                               (cl-incf total)
                               (pcase (elpaca<-status (cdr entry))
                                 ('failed (cl-incf failed))
                                 ((or 'finished 'blocked) (cl-incf done))
                                 (_ (cl-incf pending)
                                    (push (format \"%s [%s]\" (car entry)
                                                  (elpaca<-status (cdr entry)))
                                          stuck))))
                             (message \"sync: %d/%d done, %d pending, %d failed (%.0fs)\"
                                      done total pending failed
                                      (- (float-time) start))
                             (when stuck
                               (message \"  waiting: %s\" (string-join stuck \", \")))
                             (if (> done zetta--sync-prev-done)
                                 (progn (setq zetta--sync-prev-done done)
                                        (setq zetta--sync-stall-since nil))
                               (when (and stuck (not zetta--sync-stall-since))
                                 (setq zetta--sync-stall-since (float-time)))
                               (when (and zetta--sync-stall-since
                                          (> (- (float-time) zetta--sync-stall-since) stall-limit))
                                 (message \"sync: no progress for %ds, giving up\" stall-limit)
                                 (cancel-timer zetta--sync-timer)
                                 (throw 'elpaca-timeout nil))))
                           (when (> (- (float-time) start) timeout)
                             (message \"SYNC-TIMEOUT after %ds\" timeout)
                             (cancel-timer zetta--sync-timer)
                             (throw 'elpaca-timeout nil)))))
                  (catch 'elpaca-timeout
                    (unwind-protect (elpaca-wait) (cancel-timer zetta--sync-timer)))
                  (message \"Package sync finished in %.0fs\" (- (float-time) start)))" \
        2>&1 | while IFS= read -r line; do
            echo "  $line"
        done || exit_code=$?

    if [[ $exit_code -ne 0 ]]; then
        _warn "Package sync exited with code $exit_code (continuing)"
    else
        _ok "Package sync complete"
    fi
}

# ——————————————————————————————————————————
# ci-test
# ——————————————————————————————————————————
cmd_ci_test() {
    _info "Running CI test (batch mode)…"

    # Create required files if missing
    touch ~/.dir-locals.el
    [[ -f ~/.private.el ]] || echo ";;" > ~/.private.el
    [[ -f ~/.zetta.el ]] || cp "$ZETTA_DIR/templates/zetta.example.el" ~/.zetta.el

    local logfile exit_code=0
    logfile=$(mktemp)

    # Stream output in real-time via tee so CI logs are visible during the run.
    # Use elpaca-wait with a timer for progress logging and a hard timeout.
    "$EMACS" --init-directory="$ZETTA_DIR" --batch \
        --eval "$ZETTA_CI_WATCHDOG" \
        -l "$ZETTA_DIR/init.el" \
        --eval "(defvar zetta--ci-timer nil)" \
        --eval "(let* ((start (float-time))
                       (timeout 6600))
                  (setq zetta--ci-timer
                        (run-with-timer 10 10
                         (lambda ()
                           (let ((pending 0) (failed 0) (total 0))
                             (dolist (entry (elpaca--queued))
                               (cl-incf total)
                               (pcase (elpaca<-status (cdr entry))
                                 ('failed (cl-incf failed))
                                 ((or 'finished 'blocked) nil)
                                 (_ (cl-incf pending))))
                             (message \"elpaca-wait: %d/%d done, %d pending, %d failed (%.0fs)\"
                                      (- total pending failed) total pending failed
                                      (- (float-time) start)))
                           (when (> (- (float-time) start) timeout)
                             (message \"ELPACA-TIMEOUT after %ds\" timeout)
                             (dolist (entry (elpaca--queued))
                               (unless (memq (elpaca<-status (cdr entry)) '(finished blocked))
                                 (message \"  %s [%s]\" (car entry) (elpaca<-status (cdr entry)))))
                             (cancel-timer zetta--ci-timer)
                             (throw 'elpaca-timeout nil)))))
                  (catch 'elpaca-timeout
                    (unwind-protect (elpaca-wait) (cancel-timer zetta--ci-timer)))
                  (message \"elpaca-wait: finished in %.0fs\" (- (float-time) start)))" \
        --eval "(let ((failed-pkgs (cl-remove-if-not
                                    (lambda (e) (eq (elpaca<-status (cdr e)) 'failed))
                                    (elpaca--queued))))
                  (when failed-pkgs
                    (message \"ELPACA-FAILED %d packages:\" (length failed-pkgs))
                    (dolist (e failed-pkgs)
                      (let* ((name (car e))
                             (msg (car (zetta--elpaca-events name 1))))
                        (message \"  %s: %s\" name (or msg \"unknown\"))))))" \
        --eval "(message \"ZETTA-OK packages=%d modules=%d\" (length (elpaca--queued)) (length user-files))" \
        --eval "(let* ((lock (expand-file-name \"elpaca-lock.el\" user-emacs-directory))
                       (locked (when (file-exists-p lock)
                                 (with-temp-buffer
                                   (insert-file-contents lock)
                                   (mapcar #'car (read (current-buffer))))))
                       (missing (cl-remove-if (lambda (id) (memq id locked))
                                              (mapcar #'car (elpaca--queued)))))
                  (when missing
                    (message \"LOCK-MISSING %d queued packages have no elpaca-lock.el entry: %s\"
                             (length missing)
                             (mapconcat #'symbol-name missing \" \"))))" \
        2>&1 | tee "$logfile" || exit_code=$?

    # Check for success marker
    if ! grep -q "ZETTA-OK" "$logfile"; then
        _error "Config failed to load (exit code: $exit_code)"
        grep -iE "error|wrong-type|void-function" "$logfile" | head -20
        rm -f "$logfile"
        return 1
    fi

    _ok "Config loaded successfully"
    grep "ZETTA-OK" "$logfile"

    # Hard gate (flipped 2026-07-23, once the lock caught up with compat,
    # track-changes and typst-ts-mode): an unpinned package floats at
    # whatever upstream serves that day, so the version CI tested is not
    # what a fresh install gets -- the exact drift that broke fresh
    # installs for ten weeks.  Fail the PR that introduces one.
    if grep -q "^LOCK-MISSING" "$logfile"; then
        _error "Unpinned packages -- run 'bin/zetta freeze' in this PR:"
        grep "^LOCK-MISSING" "$logfile"
        rm -f "$logfile"
        return 1
    fi

    # Check for failed elpaca packages (match only actual output, not literal
    # strings embedded in backtraces which contain the eval'd Elisp code)
    if grep -q "^ELPACA-FAILED" "$logfile"; then
        _error "Some packages failed to install:"
        grep -A 100 "^ELPACA-FAILED" "$logfile" | grep "^  " | head -20
        rm -f "$logfile"
        return 1
    fi

    # Check for serious errors (void-function, wrong-type-argument, debug-early)
    # These indicate real bugs even if the config loaded to completion.
    # "Cannot load" errors from use-package are expected on fresh installs.
    local errors
    errors=$(grep -iE "void-function|wrong-type-argument|debug-early" "$logfile" \
        | grep -v "use-package" \
        | grep -v "elpaca" \
        || true)

    rm -f "$logfile"

    if [[ -n "$errors" ]]; then
        _error "Serious errors detected:"
        echo "$errors"
        return 1
    fi
}

# ——————————————————————————————————————————
# help
# ——————————————————————————————————————————
cmd_help() {
    echo -e "${BOLD}Zetta Emacs${NC} — CLI management tool"
    echo ""
    echo "Usage: zetta <command> [args]"
    echo ""
    echo "Commands:"
    echo "  install          Install packages and native-compile"
    echo "  sync             Re-evaluate config, install new packages"
    echo "  freeze [--commit]  Write lockfile (optionally commit)"
    echo "  update           Pull all packages (backs up lockfile)"
    echo "  doctor           Diagnose environment and configuration"
    echo "  test             Start test daemon and verify startup"
    echo "  ci-sync          Install missing packages (stale cache)"
    echo "  ci-test          Batch-mode test for CI runners (no daemon)"
    echo "  help             Show this help message"
    echo ""
    echo "Environment:"
    echo "  EMACS              Path to Emacs binary (default: emacs)"
    echo "  ZETTA_DIR          Path to Zetta config (default: auto-detected)"
    echo "  ZETTA_NO_PREBUILT  Set to 1 to skip the prebuilt store and build from source"
    echo "  ZETTA_PREBUILT_URL Alternate base URL for prebuilt stores (testing)"
}

# ——————————————————————————————————————————
# Main dispatch
# ——————————————————————————————————————————
case "${1:-help}" in
    install) cmd_install ;;
    sync)    cmd_sync ;;
    freeze)  cmd_freeze "${2:-}" ;;
    update)  cmd_update ;;
    doctor)  cmd_doctor ;;
    test)    cmd_test ;;
    ci-sync) cmd_ci_sync ;;
    ci-test) cmd_ci_test ;;
    help|--help|-h) cmd_help ;;
    *)
        _error "Unknown command: $1"
        echo ""
        cmd_help
        exit 1
        ;;
esac
